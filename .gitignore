# ─────────────────────────────────────────────────────────────
# ALWAYS — language-neutral. Keep all of this.
# ─────────────────────────────────────────────────────────────

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Secrets and local environment
# Anything holding a token, key or password belongs here BEFORE it is created,
# never after. Add the real filename the moment such a file is introduced.
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json

# Secrets rule of thumb: if a tool normally writes its credentials file
# somewhere else, ignore that filename here anyway. A run started from the
# repo root can drop a copy into the repo, and that copy is committable.

# Claude Code local settings (machine-specific, not shared)
.claude/settings.local.json


# ─────────────────────────────────────────────────────────────
# OPTIONAL — delete every block that does not apply.
# ─────────────────────────────────────────────────────────────

# ---- Node / JavaScript / TypeScript ----
node_modules/
dist/
build/
.next/
.nuxt/
.cache/
.turbo/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
.pytest_cache/
.coverage
.tox/
.mypy_cache/
.ruff_cache/
